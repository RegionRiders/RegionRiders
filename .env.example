# Strava OAuth Configuration
# Get your credentials from https://www.strava.com/settings/api

STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_CLIENT_ACCESS_TOKEN=your_access_token_here
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Database Configuration
# PostgreSQL connection settings

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=regionriders
POSTGRES_USER=regionriders_user
POSTGRES_PASSWORD=regionriders_pass

# Encryption Configuration
# Required for OAuth token encryption at rest
# SECURITY: Generate unique values per installation using:
#   openssl rand -hex 32  (for OAUTH_ENCRYPTION_KEY)
#   openssl rand -hex 16  (for OAUTH_ENCRYPTION_SALT)
#
# WARNING: Never share these values across installations. Each deployment must have
# unique keys/salts to prevent rainbow table attacks.
OAUTH_ENCRYPTION_KEY=your-secure-encryption-key-here
OAUTH_ENCRYPTION_SALT=your-unique-installation-salt-here
