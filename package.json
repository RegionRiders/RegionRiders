{
  "name": "mantine-next-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run eslint && npm run stylelint",
    "eslint": "eslint .",
    "stylelint": "stylelint '**/*.css' --cache",
    "jest": "node run-jest.js",
    "jest:watch": "node run-jest.js --watch",
    "test:unit": "cross-env DB_TEST_SKIP=true node run-jest.js",
    "test:db": "node run-jest.js --testPathPattern='lib/db'",
    "test:integration": "node run-jest.js --testPathPatterns='(lib/db|app/api)'",
    "test:all": "npm run prettier:check && npm run lint && npm run typecheck && node run-jest.js",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "npm run prettier:check && npm run lint && npm run typecheck && npm run test:unit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d postgres",
    "db:setup": "./scripts/setup-db.sh",
    "db:test-ssl": "node scripts/test-ssl-connection.js",
    "fetch:regions": "tsx tools/fetchRegions.ts",
    "regions:validate-source": "tsx tools/validateRegionSource.ts",
    "regions:build-tiles": "tsx tools/buildRegionTiles.ts",
    "regions:prepare-v1": "npm run regions:validate-source && npm run regions:build-tiles -- --force"
  },
  "dependencies": {
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/react": "^9.3.1",
    "@mantine/core": "^9.1.0",
    "@mantine/hooks": "^9.1.0",
    "@next/bundle-analyzer": "^16.2.4",
    "@tabler/icons-react": "^3.41.1",
    "@types/leaflet": "^1.9.21",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "leaflet.vectorgrid": "^1.3.0",
    "next": "^16.2.4",
    "pg": "^8.20.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "rbush": "^4.0.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sonic-boom": "^5.0.0",
    "strava-v3": "^4.0.1",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@storybook/addon-themes": "^10.3.4",
    "@storybook/nextjs": "^10.3.4",
    "@storybook/react": "^10.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/jest": "^30.0.0",
    "@types/leaflet.vectorgrid": "^1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "19.2.14",
    "babel-loader": "^10.1.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-config-mantine": "^4.0.3",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "postcss": "^8.5.12",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.3",
    "storybook": "^10.3.4",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.0",
    "undici": "^8.1.0"
  },
  "packageManager": "yarn@4.10.3"
}
